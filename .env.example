# Copy to .env and adjust. All optional - these are the defaults. install.sh makes .env for you.
# Port WheresMyMoney is served on (http://<this machine>:PORT).
PORT=8080
# Your time zone: days roll over, and the spending month counts, at midnight here.
TZ=Australia/Brisbane

# --- sign-in -- the first visit creates the household's first account, with the set-up code in the log ---
# Set to false only if a reverse proxy in front of it already handles sign-in.
AUTH=true
# Behind a reverse proxy: the proxy's address, so sign-in sees each browser's own address.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Fill an empty database with a made-up household, to try it out (never touches one with accounts in it).
DEMO=false
# Serve the API's own documentation at /api/docs (behind sign-in).
API_DOCS=false
